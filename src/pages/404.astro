---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found — Danis Nazri"
  description="The page you are looking for does not exist. Return to the portfolio homepage."
  noindex
>
  <main class="min-h-screen flex items-center justify-center px-4 py-24 bg-slate-950 text-slate-100">
    <div class="max-w-lg text-center space-y-6">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-cyan-400">Error 404</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-white">
        This page could not be found.
      </h1>
      <p class="text-sm text-slate-400 leading-relaxed">
        The link may be outdated or the page may have moved. Head back to the portfolio to continue exploring my work, services, and experience.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-semibold text-xs sm:text-sm px-5 py-3 rounded-xl transition-colors"
        >
          Back to Home
        </a>
        <a
          href="/#contact"
          class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 border border-slate-800 text-slate-200 font-medium text-xs sm:text-sm px-5 py-3 rounded-xl transition-colors"
        >
          Get in Touch
        </a>
      </div>
    </div>
  </main>
</Layout>
